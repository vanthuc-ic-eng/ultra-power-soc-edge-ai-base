!synth_sky130/reports/*.log

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyc

# OS & Editor Artifacts
.DS_Store
*.swp
*.bak
*~

